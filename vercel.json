{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/a/(.*)",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors *" }]
    },
    {
      "source": "/((?!a/).*)",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }]
    }
  ]
}
